APP_PORT=8098
DATA_DIR=/opt/fjordvpn-data
LAN_SUBNETS=192.168.1.0/24
TZ=Europe/Copenhagen
# Optional additional hostnames, comma-separated. With an empty value, localhost
# and IPv4 addresses in LAN_SUBNETS are accepted. Include your LAN IP when set.
UI_ALLOWED_HOSTS=
# FjordHub injects these for managed installations. Leave BOTH empty standalone.
FJORDHUB_URL=
FJORDHUB_API_KEY=
FJORDHUB_APP_ID=fjordvpn
